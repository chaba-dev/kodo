<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  content_class="mx-auto max-w-6xl space-y-8"
>
  <section id="session-index" class="space-y-8">
    <header class="flex flex-col gap-4 border-b border-zinc-200 pb-7 dark:border-zinc-800 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-violet-600 dark:text-violet-400">
          Workspace activity
        </p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight text-zinc-950 dark:text-white">
          Sessions
        </h1>
        <p class="mt-2 max-w-xl text-sm leading-6 text-zinc-600 dark:text-zinc-400">
          Follow active agents, review completed work, and continue any session from the browser.
        </p>
      </div>
      <div class="flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-4 py-2 text-xs font-medium text-zinc-600 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
        <span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(52,211,153,0.12)]"></span>
        Live updates
      </div>
    </header>

    <div id="sessions" phx-update="stream" class="grid gap-4 md:grid-cols-2">
      <div
        id="sessions-empty"
        class="hidden only:flex min-h-72 flex-col items-center justify-center rounded-3xl border border-dashed border-zinc-300 bg-zinc-50/70 px-8 text-center dark:border-zinc-700 dark:bg-zinc-900/40 md:col-span-2"
      >
        <div class="flex size-12 items-center justify-center rounded-2xl bg-violet-100 text-violet-600 dark:bg-violet-500/15 dark:text-violet-300">
          <.icon name="hero-command-line" class="size-6" />
        </div>
        <h2 class="mt-4 font-semibold text-zinc-900 dark:text-white">No sessions yet</h2>
        <p class="mt-1 max-w-sm text-sm leading-6 text-zinc-500 dark:text-zinc-400">
          Start Kodo in a repository from the CLI. Your durable session will appear here.
        </p>
      </div>

      <.link
        :for={{dom_id, session} <- @streams.sessions}
        id={dom_id}
        navigate={~p"/sessions/#{session.id}"}
        class="group relative overflow-hidden rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-violet-300 hover:shadow-xl hover:shadow-violet-950/5 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-violet-700"
      >
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:justify-between">
          <div class="min-w-0">
            <p class="truncate text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500 dark:text-zinc-400">
              {repository_name(session.runner)}
            </p>
            <h2 class="mt-2 text-lg font-semibold text-zinc-950 transition group-hover:text-violet-700 dark:text-white dark:group-hover:text-violet-300">
              {session.title}
            </h2>
          </div>
          <span class="flex shrink-0 items-center gap-2 rounded-full bg-zinc-100 px-3 py-1.5 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-200">
            <span class={["size-2 rounded-full", status_tone(session.status)]}></span>
            {String.replace(session.status, "_", " ")}
          </span>
        </div>

        <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-zinc-100 pt-5 text-xs dark:border-zinc-800">
          <div>
            <dt class="text-zinc-500 dark:text-zinc-500">Model</dt>
            <dd class="mt-1 truncate font-mono text-zinc-700 dark:text-zinc-300">
              {session.model}
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 dark:text-zinc-500">Runner</dt>
            <dd class="mt-1 flex items-center gap-2 font-medium text-zinc-700 dark:text-zinc-300">
              <span class={[
                "size-2 rounded-full",
                if(Runners.online?(session.runner_id), do: "bg-emerald-400", else: "bg-zinc-400")
              ]}></span>
              {if Runners.online?(session.runner_id), do: "Online", else: "Offline"}
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 dark:text-zinc-500">Last activity</dt>
            <dd class="mt-1 font-medium text-zinc-700 dark:text-zinc-300">
              {Calendar.strftime(session.updated_at, "%b %-d, %H:%M")}
            </dd>
          </div>
        </dl>
      </.link>
    </div>
  </section>
</Layouts.app>
