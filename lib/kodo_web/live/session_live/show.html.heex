<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  main_class="p-0"
  content_class="w-full"
>
  <section
    id="session-detail"
    class="min-h-[calc(100vh-4rem)] bg-white dark:bg-zinc-900 lg:min-h-screen"
  >
    <header class="border-b border-zinc-200 bg-white px-4 py-3 dark:border-zinc-800 dark:bg-zinc-900 sm:px-5">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
          <.link
            navigate={~p"/sessions"}
            class="inline-flex items-center gap-1 text-xs font-medium text-zinc-500 transition hover:text-zinc-900 dark:hover:text-white"
          >
            <.icon name="hero-arrow-left" class="size-3.5" /> Sessions
          </.link>
          <h1 class="mt-1 truncate text-base font-semibold tracking-tight text-zinc-950 dark:text-white">
            {@session.title}
          </h1>
          <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.7rem] text-zinc-500 dark:text-zinc-400">
            <span class="font-semibold text-zinc-700 dark:text-zinc-300">
              {repository_name(@runner)}
            </span>
            <span class="font-mono">{@session.model}</span>
            <span>{@session.approval_policy} approvals</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <div
            id="runner-status"
            class="flex items-center gap-2 rounded-lg border border-zinc-200 px-2.5 py-1.5 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:text-zinc-300"
          >
            <span class={[
              "size-2 rounded-full",
              if(@runner_online?, do: "bg-emerald-400", else: "bg-zinc-400")
            ]}></span>
            Runner {if @runner_online?, do: "online", else: "offline"}
          </div>
          <span
            id="session-status"
            class="rounded-lg bg-zinc-100 px-2.5 py-1.5 text-xs font-semibold capitalize text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300"
          >
            {String.replace(@projection.status, "_", " ")}
          </span>
          <button
            :if={@projection.status in ["running", "awaiting_approval"]}
            id="stop-session"
            type="button"
            phx-click="cancel"
            data-confirm="Stop this session? The durable transcript will be preserved."
            class="inline-flex items-center gap-2 rounded-lg bg-rose-50 px-2.5 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100 phx-click-loading:opacity-60 dark:bg-rose-500/10 dark:text-rose-300 dark:hover:bg-rose-500/20"
          >
            <.icon name="hero-stop-solid" class="size-3.5" /> Stop
          </button>
        </div>
      </div>
    </header>

    <div class="grid items-start lg:grid-cols-[minmax(0,1fr)_24rem]">
      <main class="min-w-0 lg:border-r lg:border-zinc-200 dark:lg:border-zinc-800">
        <section
          :if={@pending_approval}
          id="pending-approval"
          class="m-4 overflow-hidden rounded-xl border border-amber-300 bg-amber-50 dark:border-amber-700/70 dark:bg-amber-950/30"
        >
          <div class="flex gap-4 p-5 sm:p-6">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-amber-200/70 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300">
              <.icon name="hero-shield-exclamation" class="size-5" />
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-400">
                Approval required
              </p>
              <h2 class="mt-1 font-semibold text-amber-950 dark:text-amber-100">
                {@pending_approval["description"] || "Run #{@pending_approval["name"]}"}
              </h2>
              <pre class="mt-3 max-h-40 overflow-auto whitespace-pre-wrap rounded-xl bg-white/70 p-3 text-xs text-amber-950 dark:bg-black/20 dark:text-amber-100">{Jason.encode!(@pending_approval["arguments"] || %{}, pretty: true)}</pre>
              <div class="mt-4 flex gap-3">
                <button
                  id="approve-action"
                  type="button"
                  phx-click="resolve_approval"
                  phx-value-decision="approved"
                  class="rounded-xl bg-amber-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-800 phx-click-loading:opacity-60 dark:bg-amber-300 dark:text-amber-950"
                >
                  Approve
                </button>
                <button
                  id="deny-action"
                  type="button"
                  phx-click="resolve_approval"
                  phx-value-decision="denied"
                  class="rounded-xl border border-amber-400 px-4 py-2 text-sm font-semibold text-amber-900 transition hover:bg-amber-100 phx-click-loading:opacity-60 dark:text-amber-200"
                >
                  Deny
                </button>
              </div>
            </div>
          </div>
        </section>

        <section class="bg-white dark:bg-zinc-900">
          <div class="border-b border-zinc-100 px-5 py-4 dark:border-zinc-800 sm:px-6">
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">Conversation</h2>
          </div>

          <div id="messages" phx-update="stream" class="space-y-5 p-5 sm:p-6">
            <div
              id="messages-empty"
              class="hidden only:block py-12 text-center text-sm text-zinc-500"
            >
              Send a message to begin this session.
            </div>
            <article
              :for={{dom_id, event} <- @streams.messages}
              id={dom_id}
              class={[
                "flex gap-3",
                event.type == "user_message" && "flex-row-reverse"
              ]}
            >
              <div class={[
                "flex size-8 shrink-0 items-center justify-center rounded-xl",
                event.type == "user_message" &&
                  "bg-violet-100 text-violet-700 dark:bg-violet-500/15 dark:text-violet-300",
                event.type != "user_message" &&
                  "bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900"
              ]}>
                <.icon
                  name={if(event.type == "user_message", do: "hero-user", else: "hero-sparkles")}
                  class="size-4"
                />
              </div>
              <div class={[
                "max-w-[85%] rounded-2xl px-4 py-3 text-sm leading-6",
                event.type == "user_message" && "rounded-tr-sm bg-violet-600 text-white",
                event.type != "user_message" &&
                  "rounded-tl-sm bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-100"
              ]}>
                <p class="whitespace-pre-wrap">{event.payload["content"]}</p>
              </div>
            </article>
          </div>

          <.form
            for={@message_form}
            id="message-form"
            phx-submit="send_message"
            class="border-t border-zinc-100 p-4 dark:border-zinc-800 sm:p-5"
          >
            <div class="flex items-end gap-3">
              <.input
                field={@message_form[:content]}
                type="textarea"
                rows="2"
                placeholder="Ask Kodo to inspect, change, or verify…"
                disabled={@projection.status in ["running", "awaiting_approval"]}
                class="block min-h-12 w-full resize-none rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm text-zinc-900 outline-none transition placeholder:text-zinc-400 focus:border-violet-400 focus:ring-4 focus:ring-violet-500/10 disabled:cursor-not-allowed disabled:opacity-60 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100"
              />
              <button
                id="send-message"
                type="submit"
                disabled={@projection.status in ["running", "awaiting_approval"]}
                class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-violet-600 text-white shadow-lg shadow-violet-600/20 transition hover:-translate-y-0.5 hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-40 phx-submit-loading:translate-y-0"
                aria-label="Send message"
              >
                <.icon name="hero-arrow-up" class="size-5" />
              </button>
            </div>
          </.form>
        </section>

        <section class="border-t border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
          <div class="border-b border-zinc-100 px-5 py-4 dark:border-zinc-800 sm:px-6">
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">Tool activity</h2>
          </div>
          <div
            id="tools"
            phx-update="stream"
            class="divide-y divide-zinc-100 dark:divide-zinc-800"
          >
            <p
              id="tools-empty"
              class="hidden only:block px-6 py-10 text-center text-sm text-zinc-500"
            >
              Tool calls and command output will appear here.
            </p>
            <details
              :for={{dom_id, tool} <- @streams.tools}
              id={dom_id}
              class="group px-5 py-4 sm:px-6"
            >
              <summary class="flex cursor-pointer list-none items-center gap-3">
                <span class="flex size-8 items-center justify-center rounded-xl bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                  <.icon name="hero-command-line" class="size-4" />
                </span>
                <span class="min-w-0 flex-1 truncate font-mono text-xs font-semibold text-zinc-800 dark:text-zinc-200">
                  {tool["name"]}
                </span>
                <span class="text-xs capitalize text-zinc-500">
                  {String.replace(tool["state"], "tool_", "")}
                </span>
                <.icon
                  name="hero-chevron-down"
                  class="size-4 text-zinc-400 transition group-open:rotate-180"
                />
              </summary>
              <div class="mt-3 pl-11">
                <pre
                  :if={tool_output(tool) != ""}
                  class="max-h-80 overflow-auto whitespace-pre-wrap rounded-xl bg-zinc-950 p-4 text-xs leading-5 text-zinc-200"
                >{tool_output(tool)}</pre>
                <pre
                  :if={tool["arguments"]}
                  class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap rounded-xl bg-zinc-100 p-4 text-xs text-zinc-700 dark:bg-zinc-950 dark:text-zinc-300"
                >{Jason.encode!(tool["arguments"], pretty: true)}</pre>
              </div>
            </details>
          </div>
        </section>
      </main>

      <aside class="lg:sticky lg:top-0 lg:max-h-screen lg:overflow-auto">
        <section class="overflow-hidden bg-white dark:bg-zinc-900">
          <div class="flex items-center justify-between border-b border-zinc-100 px-5 py-4 dark:border-zinc-800">
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">Changed files</h2>
            <span
              id="changed-file-count"
              title={if(@diff.truncated?, do: "At least this many changed files", else: nil)}
              class="rounded-full bg-zinc-100 px-2 py-1 text-[0.65rem] font-semibold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"
            >
              {changed_file_count(@diff)}
            </span>
          </div>
          <div
            :if={@diff.truncated?}
            id="diff-truncated-warning"
            role="alert"
            class="border-b border-amber-200 bg-amber-50 px-5 py-3 text-xs leading-5 text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-200"
          >
            Diff output was truncated. The changed-file count and patch below are partial.
          </div>
          <div id="changed-files" class="p-3">
            <p
              :if={@diff.content == ""}
              class="px-3 py-8 text-center text-xs leading-5 text-zinc-500"
            >
              No diff has been recorded yet.
            </p>
            <div
              :for={path <- diff_files(@diff.content)}
              class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-xs text-zinc-700 dark:text-zinc-300"
            >
              <.icon name="hero-document-text" class="size-4 shrink-0 text-violet-500" />
              <span class="truncate font-mono">{path}</span>
            </div>
          </div>
        </section>

        <details
          :if={@diff.content != ""}
          id="diff-viewer"
          open
          class="group overflow-hidden border-t border-zinc-800 bg-zinc-950"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold text-zinc-100">
            Latest diff
            <.icon
              name="hero-chevron-down"
              class="size-4 text-zinc-500 transition group-open:rotate-180"
            />
          </summary>
          <pre class="max-h-[38rem] overflow-auto whitespace-pre-wrap break-all border-t border-zinc-800 p-5 text-xs leading-5 text-zinc-300">{@diff.content}</pre>
        </details>
      </aside>
    </div>
  </section>
</Layouts.app>
